param([string]$PrinterIp, [switch]$ResetHostKey)
$ErrorActionPreference = 'Stop'
if (-not $PrinterIp) { $PrinterIp = Read-Host 'Printer IP address' }
if ($PrinterIp -notmatch '^[A-Za-z0-9.-]+$') { throw 'Invalid printer address.' }
$archive = Join-Path $PSScriptRoot 'cc2-control-payload.tar.gz'
if (-not (Test-Path $archive)) { throw 'The updater payload archive is missing.' }
foreach ($tool in 'ssh.exe', 'scp.exe') {
    if (-not (Get-Command $tool -ErrorAction SilentlyContinue)) { throw "$tool is required. Enable Windows OpenSSH Client." }
}
$target = "root@$PrinterIp"
if ($ResetHostKey) {
    if (-not (Get-Command ssh-keygen.exe -ErrorAction SilentlyContinue)) {
        throw 'ssh-keygen.exe is required to reset the saved host key.'
    }
    Write-Host "The saved SSH host key for $PrinterIp will be removed."
    Write-Host 'Continue only if you expected the printer host key to change.'
    Write-Host 'OpenSSH will ask you to verify and accept the new fingerprint.'
    $confirmation = Read-Host "Type the printer address ($PrinterIp) to confirm"
    if ($confirmation -cne $PrinterIp) {
        throw 'Host-key reset cancelled. No installation was performed.'
    }
    & ssh-keygen.exe -R $PrinterIp
    if ($LASTEXITCODE -ne 0) {
        throw 'Host-key reset failed. No installation was performed.'
    }
}
$runner = Join-Path $PSScriptRoot 'run-install.sh'
if ((Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash.ToLowerInvariant() -ne '@APP_SHA@') { throw 'Local archive checksum mismatch' }
if ((Get-FileHash -LiteralPath $runner -Algorithm SHA256).Hash.ToLowerInvariant() -ne '@RUNNER_SHA@') { throw 'Local runner checksum mismatch' }
$prepare = Join-Path $PSScriptRoot 'prepare-disk.sh'
$verify = Join-Path $PSScriptRoot 'verify-and-run.sh'
if ((Get-FileHash -LiteralPath $prepare -Algorithm SHA256).Hash.ToLowerInvariant() -ne '@PREPARE_SHA@') { throw 'Local preparation script checksum mismatch' }
if ((Get-FileHash -LiteralPath $verify -Algorithm SHA256).Hash.ToLowerInvariant() -ne '@VERIFY_SHA@') { throw 'Local verification script checksum mismatch' }
$network = Join-Path $PSScriptRoot 'cc2-connections.tar.gz'
if ((Get-FileHash -LiteralPath $network -Algorithm SHA256).Hash.ToLowerInvariant() -ne '@NETWORK_SHA@') { throw 'Connections archive checksum mismatch' }
Write-Host 'Uploading disk preparation script.'
& scp.exe -O $prepare "${target}:@STAGE@-prepare.sh"
if ($LASTEXITCODE) { throw 'Preparation script upload failed; no installation started' }
& ssh.exe $target 'sh @STAGE@-prepare.sh'
if ($LASTEXITCODE) { throw 'Disk staging preparation failed; no installation started' }
& scp.exe -O $archive $network $runner $verify "${target}:@STAGE@/"
if ($LASTEXITCODE) { throw 'Payload upload failed' }
& ssh.exe $target 'sh @STAGE@/verify-and-run.sh'
if ($LASTEXITCODE) { throw 'Installation failed. Read INSTALLER_EXIT / LAST_PHASE and the disk log.' }
Write-Host "CC2 Control installed: http://${PrinterIp}:8081" -ForegroundColor Green
