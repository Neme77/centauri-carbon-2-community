builder/current/components/ssh/sshd.init -text
builder/current/components/ssh/sshd_config -text
builder/current/patches/z-offset/patch_zoffset.py -text
builder/current/patches/http-upload/http_upload_v1.json -text
builder/current/dualtrust/apply_dualtrust.py -text
builder/current/dualtrust/cc2_community_release_public.pem -text
builder/current/keys/cc2_stock_public.pem -text
builder/current/tools/cc2_sig_tool_v1.1.py -text
builder/current/core/firmware_builder.py -text

# Standalone updater shell launchers.
cc2-control/FIRMWARE_VERSION -text
cc2-control/updater/trusted-key.json text eol=lf
cc2-control/installer/*.sh text eol=lf
cc2-control/installer/pc-stage.sh.in text eol=lf
*.sh text eol=lf
*.init text eol=lf
**/cc2-configure text eol=lf
builder/current/prepare.py text eol=lf
cc2-control/src/mqtt.c text eol=lf
cc2-control/src/mqtt.h text eol=lf

# OTA 02.01.01.07 qualification inputs: preserve exact SHA-256 bytes.
experimental/firmware-port/patch_*.py -text
experimental/firmware-port/*-manifest.json -text
experimental/firmware-port/dual44-manifest.json -text
experimental/firmware-port/http44-manifest.json -text
experimental/firmware-port/network44-manifest.json -text
experimental/firmware-port/cc2_community_release_public.pem -text

experimental/native-display/thermal.awk text eol=lf

# Signed catalogs are binary even when their signature contains no NUL byte.
*.cc2catalog -text

# The 4.4.4 qualification snapshot and native pins are byte-exact.
# Preserve those reviewed bytes when staging/checking out the release sources.
/cc2-control/** -text
/builder/current/** -text
/experimental/** -text

# Web formatter inputs are canonical LF; retain native hash-pinned inputs above.
cc2-control/web-src/**/*.ts text eol=lf
cc2-control/web-src/**/*.tsx text eol=lf
cc2-control/web-src/biome.json text eol=lf
experimental/**/*.awk text eol=lf
experimental/**/*.sh.in text eol=lf
