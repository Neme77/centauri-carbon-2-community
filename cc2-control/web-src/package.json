{
  "name": "cc2-control-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc -p . && biome check .",
    "format": "biome format --write .",
    "preview:ui": "vite --mode demo --host 127.0.0.1",
    "test:preview": "node preview/test-browser.mjs",
    "test:recovery": "node preview/test-recovery-download.mjs",
    "test:upload": "node preview/test-upload-network.mjs",
    "test:mesh": "node preview/test-adaptive-mesh.mjs",
    "test:camera": "node preview/test-camera-stream.mjs",
    "test:quick": "node preview/test-quick-actions.mjs",
    "test:print-history": "node preview/test-print-history.mjs",
    "test:filaments": "node preview/test-filament-mapping.mjs",
    "test:mesh-selector": "node preview/test-mesh-selector.mjs",
    "test:plates": "node preview/test-bed-plates.mjs",
    "test:spools": "node preview/test-spools.mjs",
    "test:calibration": "node preview/test-mesh-calibration.mjs",
    "test:job-objects": "node preview/test-job-objects.mjs",
    "test:pid": "node preview/test-pid.mjs",
    "test:print-temperatures": "node preview/test-print-temperatures.mjs",
    "test:printer-reports": "node preview/test-printer-reports.mjs",
    "test:control-calibrations": "node preview/test-control-calibrations.mjs",
    "test:fans": "node preview/test-fan-inputs.mjs",
    "test:canvas-reset": "node preview/test-canvas-reset.mjs && node preview/test-canvas-presence.mjs",
    "test:languages": "node preview/test-polish-czech.mjs",
    "test:hungarian": "node preview/test-hungarian.mjs",
    "test:spanish": "node preview/test-spanish.mjs",
    "test:materials": "node preview/test-material-presets.mjs",
    "test:list-pages": "node preview/test-files-history-pages.mjs",
    "test:updates": "node preview/test-updates.mjs",
    "test:control-interactions": "node preview/test-control-interactions.mjs",
    "test:canvas-states": "node preview/test-canvas-states.mjs",
    "test:object-layout": "node preview/test-object-layout.mjs && node preview/test-object-selection.mjs",
    "test:mesh-side-labels": "node preview/test-mesh-side-labels.mjs",
    "test:plate-flow": "node preview/test-empty-plate-flow.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-preact": "^1.48.0",
    "preact": "^10.29.8"
  }
}
